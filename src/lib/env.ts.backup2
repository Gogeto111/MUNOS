`n"use server";`nimport { z } from "zod";`n`nconst serverSchema = z.object({`n  DATABASE_URL: z.string().min(1, "DATABASE_URL is required"),`n  CLERK_SECRET_KEY: z.string().optional().default(""),`n  CLERK_WEBHOOK_SECRET: z.string().optional().default(""),`n  SUPABASE_SERVICE_ROLE_KEY: z.string().optional().default(""),`n  SUPABASE_URL: z.string().optional().default(""),`n  GOOGLE_GENERATIVE_AI_API_KEY: z.string().optional().default(""),`n  GOOGLE_SEARCH_API_KEY: z.string().optional().default(""),`n  GOOGLE_SEARCH_CX: z.string().optional().default(""),`n  AI_MODEL: z.string().optional().default("gemini-2.5-flash"),`n  NEXT_PUBLIC_APP_URL: z.string().optional().default("http://localhost:3000"),`n  NEXT_PUBLIC_SUPABASE_URL: z.string().optional().default(""),`n  NEXT_PUBLIC_SUPABASE_ANON_KEY: z.string().optional().default(""),`n});`n`nconst devSchema = z.object({`n  DATABASE_URL: z.string().optional().default(""),`n  CLERK_SECRET_KEY: z.string().optional().default(""),`n  CLERK_WEBHOOK_SECRET: z.string().optional().default(""),`n  SUPABASE_SERVICE_ROLE_KEY: z.string().optional().default(""),`n  SUPABASE_URL: z.string().optional().default(""),`n  GOOGLE_GENERATIVE_AI_API_KEY: z.string().optional().default(""),`n  GOOGLE_SEARCH_API_KEY: z.string().optional().default(""),`n  GOOGLE_SEARCH_CX: z.string().optional().default(""),`n  AI_MODEL: z.string().optional().default("gemini-2.5-flash"),`n  NEXT_PUBLIC_APP_URL: z.string().optional().default("http://localhost:3000"),`n  NEXT_PUBLIC_SUPABASE_URL: z.string().optional().default(""),`n  NEXT_PUBLIC_SUPABASE_ANON_KEY: z.string().optional().default(""),`n});`n`nconst isProd = process.env.NODE_ENV === "production";`nconst schema = isProd ? serverSchema : devSchema;`n`nconst result = schema.safeParse(process.env);`n`nif (!result.success) {`n  const errors = result.error.flatten().fieldErrors;`n  const msg = `[env] Invalid environment variables:`n${Object.entries(errors).map(([k, v]) => `  ${k}: ${v?.join(", ")}`).join("`n")}`;`n  if (isProd) {`n    // In production, fail hard ??? ??" missing env vars cause silent data leaks.`n    console.error(msg);`n    throw new Error(msg);`n  } else {`n    console.warn(msg);`n  }`n}`n`n/**`n * Server-only environment. Importing this module from a Client Component`n * throws at build time ??? ??" a hard guarantee that secrets never leak.`n */`nexport const env = result.success`n  ? result.data`n  : ({} as z.infer<typeof serverSchema>);`n`nexport const isServerConfigured = Boolean(`n  env.DATABASE_URL && env.CLERK_SECRET_KEY,`n);`n`nexport const isAiConfigured = Boolean(env.GOOGLE_GENERATIVE_AI_API_KEY);`n`nexport const isWebSearchConfigured = Boolean(`n  env.GOOGLE_SEARCH_API_KEY &&`n  env.GOOGLE_SEARCH_CX,`n);`n`nexport const isStorageConfigured = Boolean(`n  env.SUPABASE_SERVICE_ROLE_KEY && env.SUPABASE_URL,`n);`n`n/** Production-ready checks ??? ??" all critical services must be configured. */`nexport function validateProductionEnv() {`n  const missing: string[] = [];`n  if (!env.DATABASE_URL) missing.push("DATABASE_URL");`n  if (!env.CLERK_SECRET_KEY) missing.push("CLERK_SECRET_KEY");`n  if (!env.SUPABASE_SERVICE_ROLE_KEY) missing.push("SUPABASE_SERVICE_ROLE_KEY");`n  if (!env.SUPABASE_URL) missing.push("SUPABASE_URL");`n  if (missing.length > 0) {`n    console.warn(`[env] Missing production env vars: ${missing.join(", ")}`);`n    return { ok: false as const, missing };`n  }`n  return { ok: true as const, missing: [] };`n}`n